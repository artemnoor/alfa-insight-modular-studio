# Local adapter configuration
ALFA_INSIGHT_API_PORT=8097

# External AI is opt-in and only runs after a manual click in the UI.
ALFA_ALLOW_EXTERNAL_AI=false
ALFA_ENABLE_EXTERNAL_AI=0
# Set POLZA_AI_API_KEY in the user environment or a local, untracked .env file.

# If the read-only archive API is started separately, configure its CORS origin
# in that process to match the exact Vite URL shown by npm run dev.
