# Dedicated T10 database URL. T10 stores its data in the separate PostgreSQL schema `t10`.
T10_DATABASE_URL=postgresql://alfa_spikes:CHANGE_ME@127.0.0.1:55436/alfa_spikes
T10_PORT=8095
POLZA_API_BASE_URL=https://polza.ai/api
# Set POLZA_AI_API_KEY in this file for local model calls. Do not commit secrets.
T10_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
T10_MATCH_MODEL=typesafe/jev
T10_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
T10_REASONING_EFFORT=none
# Maximum relation-cue chunks to recheck after B06 returns no candidate (0 disables).
T10_B06_RECOVERY_MAX_CHUNKS=12
# Maximum relation/reference-cue chunks for B04's document-context pass (hard cap 12; 0 disables).
T10_B04_DOCUMENT_CONTEXT_MAX_CHUNKS=12
